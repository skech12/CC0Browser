<Window x:Class="NeurvanceBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Neurvance"
        Height="720"
        Width="1180"
        MinHeight="500"
        MinWidth="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#1E1E1E"
        Foreground="#E0E0E0"
        FontFamily="Segoe UI"
        Icon="Assets/neurvance.png"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Borderless icon button with hover fill -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#AAAAAA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#3A3A3A" />
                                <Setter Property="Foreground" Value="#DDDDDD" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#484848" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#4A4A4A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimal window controls for the custom title bar -->
        <Style x:Key="WindowBtn" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#BEBEBE" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#3A3A3A" />
                                <Setter Property="Foreground" Value="#F2F2F2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#464646" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseWindowBtn" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#BEBEBE" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#A31910" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Horizontal tab title button -->
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="MaxWidth" Value="220" />
            <Setter Property="Padding" Value="14,0,6,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#999999" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="10,10,0,0">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#333333" />
                                <Setter Property="Foreground" Value="#CCCCCC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab close button -->
        <Style x:Key="TabClose" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="2,0,3,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#777777" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#555555" />
                                <Setter Property="Foreground" Value="#EEEEEE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Address bar with pill shape -->
        <Style x:Key="OmniBox" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="CaretBrush" Value="#E8E8E8" />
            <Setter Property="SelectionBrush" Value="#3D6BAA" />
            <Setter Property="BorderBrush" Value="#484848" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#606060" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#323232" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#5588CC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hidden list styles (history/bookmarks kept in code) -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#E0E0E0" />
        </Style>
        <DataTemplate x:Key="StoredPageTemplate">
            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12" />
        </DataTemplate>

    </Window.Resources>

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />   <!-- custom title/tab bar -->
            <RowDefinition Height="46" />   <!-- nav bar -->
            <RowDefinition Height="*" />    <!-- content -->
            <RowDefinition Height="22" />   <!-- status -->
        </Grid.RowDefinitions>

        <!-- Custom title/tab bar -->
        <Border Grid.Row="0" Background="#202124" BorderBrush="#383838" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeWindowButton"
                            Style="{StaticResource WindowBtn}"
                            Content="&#xE921;"
                            ToolTip="Minimize"
                            Click="MinimizeWindowButton_Click" />
                    <Button x:Name="MaximizeWindowButton"
                            Style="{StaticResource WindowBtn}"
                            Content="&#xE922;"
                            ToolTip="Maximize"
                            Click="MaximizeWindowButton_Click" />
                    <Button x:Name="CloseWindowButton"
                            Style="{StaticResource CloseWindowBtn}"
                            Content="&#xE8BB;"
                            ToolTip="Close"
                            Click="CloseWindowButton_Click" />
                </StackPanel>
                <Button x:Name="NewTabButton"
                        DockPanel.Dock="Right"
                        Style="{StaticResource NavBtn}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Content="&#xE710;"
                        ToolTip="New tab"
                        Click="NewTabButton_Click"
                        Width="36"
                        Margin="4,4,6,4" />
                <Grid DockPanel.Dock="Left" Width="54" IsHitTestVisible="False">
                    <Image Source="Assets/neurvance.png"
                           Width="28"
                           Height="28"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True" />
                </Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TabStrip"
                                Orientation="Horizontal"
                                Margin="0,4,0,0" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ── Nav bar ── -->
        <Border Grid.Row="1" Background="#222222" BorderBrush="#383838" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel>
                <!-- Back · Forward · Reload -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,4,0">
                    <Button x:Name="BackButton"    Style="{StaticResource NavBtn}" Content="&#xE72B;" ToolTip="Back"    Click="BackButton_Click" />
                    <Button x:Name="ForwardButton" Style="{StaticResource NavBtn}" Content="&#xE72A;" ToolTip="Forward" Click="ForwardButton_Click" />
                    <Button x:Name="ReloadButton"  Style="{StaticResource NavBtn}" Content="&#xE72C;" ToolTip="Reload"  Click="ReloadButton_Click" />
                </StackPanel>
                <!-- Home · Bookmark · Settings -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,0,0,0">
                    <Button x:Name="HomeButton"     Style="{StaticResource NavBtn}" Content="&#xE80F;" ToolTip="Home"     Click="HomeButton_Click" />
                    <Button x:Name="BookmarkButton" Style="{StaticResource NavBtn}" Content="&#xE734;" ToolTip="Bookmark" Click="BookmarkButton_Click" />
                    <Button x:Name="SettingsButton" Style="{StaticResource NavBtn}" Content="&#xE713;" ToolTip="Settings" Click="SettingsButton_Click" />
                </StackPanel>
                <!-- Address bar -->
                <DockPanel>
                    <Button x:Name="GoButton"
                            DockPanel.Dock="Right"
                            Style="{StaticResource NavBtn}"
                            Content="&#xE721;"
                            ToolTip="Go"
                            Click="GoButton_Click"
                            Margin="4,0,0,0" />
                    <TextBox x:Name="AddressBar"
                             Style="{StaticResource OmniBox}"
                             KeyDown="AddressBar_KeyDown" />
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- ── Content ── -->
        <ContentControl x:Name="BrowserHost"
                        Grid.Row="2"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />

        <!-- ── Status bar ── -->
        <Border Grid.Row="3" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="10,0">
            <TextBlock x:Name="StatusText"
                       Text="Ready"
                       Foreground="#666666"
                       FontSize="11"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- Hidden controls required by C# code (history / bookmarks) -->
        <Grid Grid.Row="2" Visibility="Collapsed">
            <ListBox x:Name="HistoryList"  ItemTemplate="{StaticResource StoredPageTemplate}" MouseDoubleClick="HistoryList_MouseDoubleClick" />
            <ListBox x:Name="BookmarkList" ItemTemplate="{StaticResource StoredPageTemplate}" MouseDoubleClick="BookmarkList_MouseDoubleClick" />
        </Grid>
    </Grid>
</Window>
